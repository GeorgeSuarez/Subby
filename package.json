    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-plugin-react": "^7.37.5",
    "expo-doctor": "^1.20.1",
    "jest": "^29.7.0",
    "sharp": "^0.35.3",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
